{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 30
    },
    "api/inbox.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
